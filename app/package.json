{
  "name": "onyoursite-web",
  "version": "3.0.0",
  "private": true,
  "description": "OnYourSite website on Node.js and TypeScript",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/formbody": "9.0.1",
    "@fastify/multipart": "10.1.6",
    "bcryptjs": "3.0.3",
    "fastify": "5.12.7",
    "mysql2": "3.24.6",
    "nodemailer": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

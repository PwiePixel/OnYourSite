{
  "name": "onyoursite-web",
  "version": "3.0.0",
  "private": true,
  "description": "OnYourSite website on Node.js and TypeScript",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "test:seed": "node --import tsx test/seed.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "bcryptjs": "3.0.3",
    "busboy": "1.6.0",
    "fastify": "5.12.7",
    "mysql2": "3.24.6",
    "nodemailer": "10.3.1",
    "sharp": "0.35.5",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/yazl": "3.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Interne Ordner und Zugangsdaten nie direkt ausliefern
    RewriteRule ^(lib|cron|email|PHPMailer|tests)(/|$) - [F,L]
    RewriteRule ^config(\.example)?\.php$ - [F,L]
    RewriteRule (^|/)\.git(/|$) - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Schriften dürfen auch in der Editor-Vorschau geladen werden
<IfModule mod_headers.c>
    <FilesMatch "\.(woff2?|ttf)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>

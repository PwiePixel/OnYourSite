<IfModule mod_rewrite.c>
    RewriteEngine On
    # Immer https – auch hinter dem Cloudflare-Tunnel: dort kommt jede Anfrage per https an, und wie der Besucher
    # gekommen ist, steht in X-Forwarded-Proto (setzt Cloudflare selbst)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Interne Ordner und Zugangsdaten nie direkt ausliefern
    RewriteRule ^(lib|cron|email|PHPMailer|tests|views|discord-bot|server)(/|$) - [F,L]
    RewriteRule (^|/)\.env$ - [F,L]
    RewriteRule ^config(\.example)?\.php$ - [F,L]
    RewriteRule (^|/)\.git(/|$) - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Schriften dürfen auch in der Editor-Vorschau geladen werden
<IfModule mod_headers.c>
    <FilesMatch "\.(woff2?|ttf)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>

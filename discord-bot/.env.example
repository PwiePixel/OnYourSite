# Copy this file to .env and fill it in. Never share .env or commit it.
# install.sh fills in all IDs by itself (it creates the Staff role and the channels) – this file is only needed
# without the installer. IDs: Discord settings -> Advanced -> Developer Mode, then right-click -> Copy ID.

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Who counts as team (accept/decline suggestions, answer and close tickets)
TEAM_ROLE_ID=

# Welcome messages (leave WELCOME_CHANNEL_ID empty to turn them off)
WELCOME_CHANNEL_ID=
# optional: role every new member gets
WELCOME_ROLE_ID=
# optional: channels mentioned in the welcome message
RULES_CHANNEL_ID=
SUPPORT_CHANNEL_ID=

# Suggestions: a forum channel; optional forum tags for accepted/declined
SUGGESTION_FORUM_ID=
TAG_ACCEPTED_ID=
TAG_DECLINED_ID=

# Support: category in which the private ticket channels are created
SUPPORT_CATEGORY_ID=

# Updates from the website are posted here (install.sh creates #updates; optional)
UPDATES_CHANNEL_ID=

# OnYourSite's status page: incidents and maintenance are posted in #status (read-only for members), alerts for the
# team in #alerts (private: only Staff and the bot). install.sh creates both; the website can choose other channels.
STATUS_CHANNEL_ID=
ALERTS_CHANNEL_ID=

# Website connection – BOT_SECRET is the same value as "bot_secret" in the website's config.json
SITE_URL=https://on-your.site
BOT_SECRET=
# How often the bot picks up changes made on the website (seconds)
POLL_SECONDS=10
